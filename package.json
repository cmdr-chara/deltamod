{
  "name": "deltamod-community",
  "productName": "Deltamod Community",
  "version": "2.0.3-beta.3",
  "nexusSsoAppId": "",
  "description": "Community-maintained Deltarune mod manager",
  "main": "node/Runner.js",
  "discordAPI": "https://discord.com/api/guilds/1390331292993982484/widget.json",
  "featureFlags": [
    "GB-OneClick"
  ],
  "scripts": {
    "build:boot": "vite build --config vite.boot.config.js",
    "dev": "electron . --developer",
    "predev": "npm run build:boot",
    "preview:heart": "vite --host 127.0.0.1 --open /preview-heart/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "security:audit": "npm audit --audit-level=high",
    "acquire:g3mtool": "node scripts/acquire-g3mtool.js",
    "verify:g3mtool": "node scripts/verify-g3mtool.js",
    "verify:g3mtool-manifest": "node scripts/verify-g3mtool.js --manifest-only",
    "archive:g3mtool-source": "node scripts/archive-g3mtool-source.js",
    "acquire:undertale-mod-tool": "node scripts/acquire-undertale-mod-tool.js",
    "verify:undertale-mod-tool": "node scripts/verify-undertale-mod-tool.js",
    "verify:packaged-undertale-mod-tool": "node scripts/verify-packaged-undertale-mod-tool.js",
    "smoke:game-patching-csx": "node scripts/smoke-game-patching-csx.js",
    "verify:undertale-mod-tool-manifest": "node scripts/verify-undertale-mod-tool.js --manifest-only",
    "archive:undertale-mod-tool-source": "node scripts/archive-undertale-mod-tool-source.js",
    "build-windows": "electron-builder --win --publish never",
    "prebuild-windows": "npm run build:boot",
    "build-linux": "electron-builder --linux --publish never",
    "prebuild-linux": "npm run build:boot",
    "build-macos": "electron-builder --mac --publish never",
    "prebuild-macos": "npm run build:boot",
    "erase-data": "Erase.bat"
  },
  "build": {
    "appId": "io.github.cmdr-chara.deltamod-community",
    "productName": "Deltamod Community",
    "icon": "build/icon-big.png",
    "asar": true,
    "artifactName": "deltamod-community-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "dist"
    },
    "asarUnpack": [
      "tools/**/*",
      "node_modules/7zip-bin/win",
      "node_modules/7zip-bin/linux",
      "node_modules/7zip-bin/mac",
      "node_modules/7zip-bin/7x.sh",
      "gm3p"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": true
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Deltamod Community",
      "installerHeader": "build/installer/installerHeader.bmp",
      "installerSidebar": "build/installer/installerSidebar.bmp",
      "uninstallerSidebar": "build/installer/installerSidebar.bmp",
      "uninstallDisplayName": "Deltamod Community ${version}"
    },
    "files": [
      "!output{,/**/*}",
      "!dist{,/**/*}",
      "!coverage{,/**/*}",
      "!tests{,/**/*}",
      "!installbuilder{,/**/*}",
      "!.codex-run{,/**/*}",
      "!.github{,/**/*}",
      "!scripts{,/**/*}",
      "!playwright.config.js",
      "!vitest.config.js",
      "!tsconfig.json"
    ],
    "linux": {
      "target": "AppImage",
      "category": "Utility",
      "icon": "build/icon-big.png"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.utilities",
      "icon": "build/icon-macos.png"
    },
    "protocols": [
      {
        "name": "Deltamod Community",
        "schemes": [
          "deltamod-community"
        ]
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "cmdr-chara",
        "repo": "deltamod",
        "releaseType": "release"
      }
    ]
  },
  "author": "Deltamod contributors",
  "license": "EUPL-1.2",
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "electron": "^41.10.3",
    "electron-builder": "^26.15.3",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@chainsafe/xdelta3-node": "^1.0.2",
    "@sentry/node": "^10.68.0",
    "7zip-bin": "5.1.1",
    "7zip-min": "^2.1.0",
    "axios": "^1.18.1",
    "cheerio": "^1.1.2",
    "create-desktop-shortcuts": "^1.11.1",
    "electron-updater": "^6.8.9",
    "js-toml": "^1.2.1",
    "mime-types": "^3.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "semver": "^7.8.5",
    "windows-elevate": "^1.0.1",
    "ws": "8.21.1",
    "xml-js": "^1.6.11",
    "yoctocolors-cjs": "^2.1.3",
    "zod": "^4.4.3"
  },
  "overrides": {
    "brace-expansion": "5.0.9",
    "form-data": "^4.0.6",
    "js-yaml": "4.3.1",
    "nanoid": "3.3.17",
    "undici": "^7.27.3"
  }
}
