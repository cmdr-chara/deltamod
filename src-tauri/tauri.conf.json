{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Deltamod Community",
  "version": "2.0.15",
  "identifier": "io.github.cmdr-chara.deltamod-community",
  "build": {
    "beforeBuildCommand": "npm run build:boot",
    "frontendDist": "../web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Deltamod Community",
        "width": 1100,
        "height": 720,
        "minWidth": 800,
        "minHeight": 560,
        "decorations": false,
        "visible": true
      }
    ],
    "security": {
      "capabilities": [
        "default"
      ],
      "csp": {
        "default-src": "'self'",
        "script-src": "'self' 'unsafe-inline'",
        "script-src-attr": "'unsafe-inline'",
        "style-src": "'self' 'unsafe-inline' https://fonts.googleapis.com",
        "style-src-attr": "'unsafe-inline'",
        "img-src": "'self' data: themeprot: packet: https://gamebanana.com https://images.gamebanana.com https://avatars.githubusercontent.com https://media.moddb.com https://static.moddb.com https://images.nexusmods.com https://staticdelivery.nexusmods.com",
        "media-src": "'self' themeprot: packet:",
        "connect-src": "'self' ipc: http://ipc.localhost https://gamebanana.com",
        "font-src": "'self' data: https://fonts.gstatic.com",
        "object-src": "'none'",
        "frame-src": "https://gamebanana.com",
        "base-uri": "'none'",
        "form-action": "'none'"
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/cmdr-chara/deltamod/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDg3OUYyODI4Nzc5NjMwNwpSV1FIWTNtSGd2SjVDTWU5SlF3RTJoR0x6N2VkVGxCWUJCNlZVaVZxZXRocjlBVGpVVzBEaVc1NQo="
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "createUpdaterArtifacts": false,
    "publisher": "Deltamod Community contributors",
    "homepage": "https://github.com/cmdr-chara/deltamod",
    "copyright": "Copyright © 2026 Deltamod Community contributors",
    "shortDescription": "A GameMaker-compatible mod manager",
    "longDescription": "Deltamod Community is a community-maintained mod manager for supported GameMaker games.",
    "icon": [
      "../build/icon-big.png"
    ],
    "license": "EUPL-1.2",
    "licenseFile": "../LICENSE.txt",
    "fileAssociations": [
      {
        "ext": [
          "modarchive"
        ],
        "name": "Deltamod Mod Archive",
        "description": "Deltamod Community mod package",
        "role": "Viewer",
        "mimeType": "application/x-deltamod-modarchive",
        "exportedType": {
          "identifier": "io.github.cmdrchara.deltamodcommunity.modarchive",
          "conformsTo": [
            "public.data"
          ]
        }
      },
      {
        "ext": [
          "deltamod-open"
        ],
        "name": "Deltamod Community Launch Request",
        "description": "Deltamod Community CLI launch request",
        "role": "Viewer",
        "mimeType": "application/x-deltamod-open",
        "exportedType": {
          "identifier": "io.github.cmdrchara.deltamodcommunity.open",
          "conformsTo": [
            "public.data"
          ]
        }
      }
    ],
    "windows": {
      "nsis": {
        "headerImage": "../build/installer/installerHeader.bmp",
        "sidebarImage": "../build/installer/installerSidebar.bmp",
        "uninstallerHeaderImage": "../build/installer/installerHeader.bmp",
        "installMode": "currentUser",
        "languages": [
          "English"
        ],
        "displayLanguageSelector": false,
        "startMenuFolder": "Deltamod Community"
      }
    },
    "externalBin": [
      "binaries/deltamod-hash-worker",
      "binaries/deltamod-security-worker",
      "binaries/deltamod-copy-worker",
      "binaries/deltamod-patch-plan-worker",
      "binaries/deltamod-patch-transaction-worker"
    ],
    "resources": {
      "../games/": "games/",
      "../web/themes/": "themes/",
      "../tools/cmodeutil.exe": "tools/cmodeutil.exe",
      "resources/third-party/": "third-party/",
      "resources/NOTICE.md": "NOTICE.md",
      "resources/THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md"
    }
  }
}
